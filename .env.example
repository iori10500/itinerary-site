# Public advisor contact shown on the page.
ADVISOR_PUBLIC_EMAIL=info@wildroadgroup.com

# Chinese advisor page only. Leave empty until a real QR image has been placed
# under public/, for example /images/wechat-contact-qr.png.
WECHAT_QR_PATH=/images/wechat-contact-qr.png

# At least one delivery channel must be configured in production.
RESEND_API_KEY=
ENQUIRY_EMAIL_TO=info@wildroadgroup.com
ENQUIRY_EMAIL_CC=steven.shan@wildroadgroup.com
ENQUIRY_EMAIL_FROM=WR Journeys <info@wildroadgroup.com>
FEISHU_ENQUIRY_WEBHOOK_URL=

# Cloudflare Turnstile. Add itinerary.wildroadgroup.com to the widget's
# allowed hostnames before enabling these values in production.
TURNSTILE_SITE_KEY=0x4AAAAAAD2QFRD4bn5jIdIa
TURNSTILE_SECRET_KEY=

# Local smoke tests only. This flag is ignored when NODE_ENV=production.
ENQUIRY_LOG_ONLY=0
