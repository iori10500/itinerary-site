<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <meta name="robots" content="noindex,nofollow,noarchive">
  <link rel="stylesheet" href="/fonts/fonts.css">
  <style>
    :root {
      --ink: #142b33;
      --ink-soft: #35515a;
      --paper: #f3efe6;
      --paper-deep: #e5ddcd;
      --foam: #faf8f2;
      --signal: #e7603b;
      --sea: #0e6d78;
      --line: rgba(20, 43, 51, 0.17);
      --serif: 'Playfair Display', Georgia, serif;
      --sans: 'Noto Sans SC', 'PingFang SC', sans-serif;
    }
    * { box-sizing: border-box; }
    html { background: var(--ink); }
    body {
      margin: 0;
      color: var(--ink);
      background:
        linear-gradient(rgba(20,43,51,.035) 1px, transparent 1px),
        linear-gradient(90deg, rgba(20,43,51,.035) 1px, transparent 1px),
        var(--paper);
      background-size: 28px 28px;
      font-family: var(--sans);
      min-height: 100vh;
    }
    button, input, select { font: inherit; }
    .masthead {
      min-height: 290px;
      padding: 30px clamp(22px, 5vw, 76px) 42px;
      color: var(--foam);
      background:
        radial-gradient(circle at 78% 18%, rgba(14,109,120,.7), transparent 32%),
        linear-gradient(128deg, #0d2027 0%, #163741 62%, #0e4a53 100%);
      position: relative;
      overflow: hidden;
    }
    .masthead::after {
      content: '';
      position: absolute;
      width: 520px;
      height: 520px;
      right: -190px;
      top: -300px;
      border: 1px solid rgba(255,255,255,.18);
      border-radius: 50%;
      box-shadow: 0 0 0 36px rgba(255,255,255,.03), 0 0 0 72px rgba(255,255,255,.025);
    }
    .topline { display: flex; justify-content: space-between; align-items: center; gap: 20px; position: relative; z-index: 1; }
    .eyebrow { text-transform: uppercase; letter-spacing: .18em; font-size: 11px; color: rgba(255,255,255,.68); }
    .internal-badge { border: 1px solid rgba(255,255,255,.28); border-radius: 999px; padding: 7px 12px; font-size: 11px; letter-spacing: .08em; }
    .hero-copy { position: relative; z-index: 1; max-width: 980px; margin-top: 56px; }
    h1 { margin: 0; font: 400 clamp(40px, 7vw, 76px)/.98 var(--serif); letter-spacing: -.035em; }
    .hero-sub { max-width: 680px; margin: 22px 0 0; color: rgba(255,255,255,.72); line-height: 1.75; font-size: 14px; }
    .hero-rule { width: 58px; height: 4px; background: var(--signal); margin-top: 28px; }
    main { width: min(1500px, calc(100% - 40px)); margin: -24px auto 0; position: relative; z-index: 2; padding-bottom: 80px; }
    .kpis { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); background: var(--foam); border: 1px solid var(--line); box-shadow: 0 18px 50px rgba(10,28,34,.16); }
    .kpi { padding: 22px 24px; min-height: 108px; border-right: 1px solid var(--line); }
    .kpi:last-child { border-right: 0; }
    .kpi-label { color: var(--ink-soft); font-size: 11px; letter-spacing: .08em; text-transform: uppercase; }
    .kpi-value { margin-top: 8px; font: 500 32px/1 var(--serif); }
    .kpi-note { color: #6e7f82; font-size: 11px; margin-top: 7px; }
    .workspace { display: grid; grid-template-columns: 286px minmax(0, 1fr); gap: 24px; margin-top: 24px; align-items: start; }
    .efficiency-band { display: grid; grid-template-columns: repeat(4, 1fr); margin-top: 24px; color: var(--foam); background: var(--ink); }
    .efficiency-item { padding: 22px 24px; border-right: 1px solid rgba(255,255,255,.13); }
    .efficiency-item:last-child { border-right: 0; }
    .efficiency-value { font: 500 29px/1 var(--serif); color: #fff; }
    .efficiency-label { margin-top: 7px; color: rgba(255,255,255,.58); font-size: 10px; letter-spacing: .08em; text-transform: uppercase; }
    .panel { background: rgba(250,248,242,.92); border: 1px solid var(--line); box-shadow: 0 12px 32px rgba(20,43,51,.07); }
    .sidebar { position: sticky; top: 18px; padding: 22px; }
    .panel-title { margin: 0 0 18px; font: 500 21px/1.2 var(--serif); }
    .field { display: grid; gap: 7px; margin-bottom: 15px; }
    .field label { font-size: 11px; color: var(--ink-soft); letter-spacing: .06em; text-transform: uppercase; }
    .control { width: 100%; min-height: 42px; border: 1px solid var(--line); border-radius: 0; background: #fffdf8; padding: 9px 11px; color: var(--ink); outline: none; }
    .control:focus { border-color: var(--sea); box-shadow: 0 0 0 2px rgba(14,109,120,.12); }
    .checkline { display: flex; gap: 9px; align-items: flex-start; font-size: 12px; line-height: 1.5; margin: 5px 0 18px; color: var(--ink-soft); }
    .checkline input { accent-color: var(--signal); margin-top: 3px; }
    .reset { width: 100%; border: 1px solid var(--ink); background: transparent; color: var(--ink); padding: 10px 12px; cursor: pointer; transition: .18s ease; }
    .reset:hover { background: var(--ink); color: #fff; }
    .distribution { border-top: 1px solid var(--line); padding-top: 20px; margin-top: 22px; }
    .dist-row { margin-top: 12px; }
    .dist-meta { display: flex; justify-content: space-between; gap: 10px; font-size: 11px; }
    .dist-track { height: 4px; margin-top: 6px; background: var(--paper-deep); overflow: hidden; }
    .dist-fill { height: 100%; background: var(--sea); transform-origin: left; animation: grow .7s ease both; }
    @keyframes grow { from { transform: scaleX(0); } }
    .results { min-width: 0; }
    .results-head { display: flex; justify-content: space-between; align-items: end; gap: 20px; padding: 22px 24px; border-bottom: 1px solid var(--line); }
    .result-count { margin: 0; font: 500 24px/1.1 var(--serif); }
    .result-meta { margin-top: 5px; color: #718185; font-size: 11px; }
    .manifest { display: grid; }
    .voyage-row {
      display: grid;
      grid-template-columns: 132px minmax(230px, 1.45fr) minmax(150px, .75fr) 90px 118px 30px;
      align-items: center;
      gap: 18px;
      min-height: 112px;
      padding: 18px 24px;
      color: inherit;
      text-decoration: none;
      border-bottom: 1px solid var(--line);
      transition: background .18s ease, transform .18s ease;
      animation: enter .42s ease both;
    }
    .voyage-row:hover { background: #fffdf8; transform: translateX(3px); }
    @keyframes enter { from { opacity: 0; transform: translateY(8px); } }
    .date-day { font: 500 22px/1 var(--serif); }
    .date-year { margin-top: 6px; font-size: 10px; color: #75868a; letter-spacing: .1em; }
    .route { font: 500 clamp(18px, 2vw, 23px)/1.2 var(--serif); }
    .journey-id { margin-top: 7px; font: 10px/1.2 ui-monospace, SFMono-Regular, Menlo, monospace; color: #7b898c; }
    .ship-name { font-size: 13px; font-weight: 600; }
    .region-list { margin-top: 7px; display: flex; flex-wrap: wrap; gap: 4px; }
    .region-tag { background: rgba(14,109,120,.09); color: var(--sea); padding: 3px 6px; font-size: 9px; letter-spacing: .08em; }
    .night-value { font: 500 21px/1 var(--serif); }
    .night-label, .end-label { margin-top: 5px; font-size: 10px; color: #7b898c; }
    .multi { color: var(--signal); font-size: 10px; margin-top: 7px; }
    .official-route { margin-top: 5px; font-size: 10px; color: #7b898c; }
    .metric-list { display: flex; flex-wrap: wrap; gap: 4px; margin-top: 8px; }
    .metric-tag { padding: 3px 6px; color: var(--ink-soft); background: var(--paper-deep); font-size: 9px; }
    .metric-tag.accent { color: #fff; background: var(--sea); }
    .arrow { font-size: 19px; color: var(--signal); transition: transform .18s ease; }
    .voyage-row:hover .arrow { transform: translateX(4px); }
    .empty { text-align: center; padding: 80px 24px; color: #718185; }
    .load-more { display: block; width: calc(100% - 48px); margin: 24px; padding: 13px; border: 1px solid var(--ink); color: var(--ink); background: transparent; cursor: pointer; }
    .load-more:hover { background: var(--ink); color: #fff; }
    .audit-strip { margin-top: 24px; padding: 20px 24px; display: flex; justify-content: space-between; gap: 22px; align-items: center; }
    .audit-copy { font-size: 12px; color: var(--ink-soft); line-height: 1.7; }
    .audit-copy strong { color: var(--ink); }
    .source-link { color: var(--sea); text-decoration-thickness: 1px; text-underline-offset: 3px; }
    .command { white-space: nowrap; border: 0; background: var(--ink); color: #fff; padding: 11px 14px; cursor: pointer; font: 11px ui-monospace, SFMono-Regular, Menlo, monospace; }
    .port-dictionary { margin-top: 24px; padding: 26px 24px; }
    .dictionary-head { display: flex; justify-content: space-between; align-items: end; gap: 20px; margin-bottom: 18px; }
    .dictionary-note { color: #718185; font-size: 11px; }
    .port-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--line); border: 1px solid var(--line); }
    .port-card { min-height: 205px; padding: 20px; background: var(--foam); }
    .port-code { color: var(--signal); font: 10px ui-monospace, SFMono-Regular, Menlo, monospace; letter-spacing: .1em; }
    .port-display { margin-top: 10px; font: 500 20px/1.22 var(--serif); }
    .port-official { margin-top: 7px; color: var(--ink-soft); font-size: 11px; }
    .port-note { margin-top: 14px; color: #596d72; font-size: 12px; line-height: 1.65; }
    .port-meta { display: flex; flex-wrap: wrap; gap: 5px; margin-top: 14px; }
    @media (max-width: 1050px) {
      .kpis { grid-template-columns: repeat(3, 1fr); }
      .kpi:nth-child(3) { border-right: 0; }
      .kpi:nth-child(n+4) { border-top: 1px solid var(--line); }
      .workspace { grid-template-columns: 1fr; }
      .efficiency-band { grid-template-columns: repeat(2, 1fr); }
      .efficiency-item:nth-child(2) { border-right: 0; }
      .efficiency-item:nth-child(n+3) { border-top: 1px solid rgba(255,255,255,.13); }
      .sidebar { position: static; display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
      .sidebar .panel-title, .sidebar .distribution, .sidebar .reset, .sidebar .checkline { grid-column: 1 / -1; }
      .voyage-row { grid-template-columns: 112px minmax(220px, 1fr) 140px 70px 30px; }
      .voyage-row > div:nth-child(5) { display: none; }
      .port-grid { grid-template-columns: repeat(2, 1fr); }
    }
    @media (max-width: 680px) {
      main { width: min(100% - 24px, 1500px); }
      .masthead { padding-left: 20px; padding-right: 20px; }
      .kpis { grid-template-columns: repeat(2, 1fr); }
      .kpi { border-top: 1px solid var(--line); }
      .kpi:nth-child(1), .kpi:nth-child(2) { border-top: 0; }
      .kpi:nth-child(even) { border-right: 0; }
      .kpi:last-child { grid-column: 1 / -1; }
      .sidebar { grid-template-columns: 1fr; }
      .sidebar .panel-title, .sidebar .distribution, .sidebar .reset, .sidebar .checkline { grid-column: auto; }
      .results-head { align-items: start; flex-direction: column; }
      .results-head .control { width: 100%; }
      .voyage-row { grid-template-columns: 92px 1fr 26px; gap: 12px; min-height: 132px; padding: 17px; }
      .voyage-row > div:nth-child(3), .voyage-row > div:nth-child(4), .voyage-row > div:nth-child(5) { display: none; }
      .audit-strip { align-items: stretch; flex-direction: column; }
      .command { white-space: normal; }
      .port-grid { grid-template-columns: 1fr; }
      .dictionary-head { align-items: start; flex-direction: column; }
    }
  </style>
  <script src="/cdn-fallback.js" defer></script>
</head>
<body>
  <header class="masthead">
    <div class="topline">
      <div class="eyebrow">WR Journeys · Ocean Product Desk</div>
      <div class="internal-badge">INTERNAL REVIEW · 不对外发布</div>
    </div>
    <div class="hero-copy">
      <h1>Explora<br>Voyage Manifest</h1>
      <p class="hero-sub">把官方 catalogue 从网页列表变成可核验的数据底稿。按船、区域、日期和港口快速检查；每条记录都可回到 Explora 官方详情页。</p>
      <div class="hero-rule"></div>
    </div>
  </header>

  <main>
    <section class="kpis" aria-label="Catalogue statistics">
      <div class="kpi"><div class="kpi-label">Unique departures</div><div class="kpi-value"><%= stats.departures %></div><div class="kpi-note">按 id-journey 去重</div></div>
      <div class="kpi"><div class="kpi-label">Voyage expressions</div><div class="kpi-value"><%= stats.voyages %></div><div class="kpi-note">官网产品路径</div></div>
      <div class="kpi"><div class="kpi-label">Vessels</div><div class="kpi-value"><%= stats.vessels %></div><div class="kpi-note">EXPLORA I–VI</div></div>
      <div class="kpi"><div class="kpi-label">Raw entries</div><div class="kpi-value"><%= stats.catalog_entries %></div><div class="kpi-note">抓取的原始卡片</div></div>
      <div class="kpi"><div class="kpi-label">Duplicates folded</div><div class="kpi-value"><%= stats.duplicate_listings %></div><div class="kpi-note">合并但保留分类关系</div></div>
    </section>

    <section class="efficiency-band" aria-label="Travel efficiency statistics">
      <div class="efficiency-item"><div class="efficiency-value"><%= (detailsStats.late_departure_share * 100).toFixed(1) %>%</div><div class="efficiency-label">18:00 后离港 · Timed calls</div></div>
      <div class="efficiency-item"><div class="efficiency-value"><%= (detailsStats.full_day_share * 100).toFixed(1) %>%</div><div class="efficiency-label">完整白天窗口 · 10:00 前到 / 18:00 后走</div></div>
      <div class="efficiency-item"><div class="efficiency-value"><%= detailsStats.official_ports %></div><div class="efficiency-label">Official ports · 全部已映射代码</div></div>
      <div class="efficiency-item"><div class="efficiency-value"><%= detailsStats.overnight_events %></div><div class="efficiency-label">Official overnight events</div></div>
    </section>

    <div class="workspace">
      <aside class="panel sidebar">
        <h2 class="panel-title">Filter the manifest</h2>
        <div class="field"><label for="search">港口 / ID / 路线</label><input id="search" class="control" type="search" placeholder="例如 Barcelona 或 EX2026…"></div>
        <div class="field"><label for="vessel">Vessel</label><select id="vessel" class="control"><option value="">全部船只</option></select></div>
        <div class="field"><label for="region">Region</label><select id="region" class="control"><option value="">全部区域</option></select></div>
        <div class="field"><label for="month">Embarkation month</label><input id="month" class="control" type="month"></div>
        <label class="checkline"><input id="multi" type="checkbox">只看被多个 voyage 分类引用的 departure</label>
        <label class="checkline"><input id="tender" type="checkbox">只看包含 TENDER 港口的航次</label>
        <label class="checkline"><input id="annotated" type="checkbox">只看起止港含 WR 中文注解的航次</label>
        <button id="reset" class="reset" type="button">清除全部筛选</button>
        <div class="distribution">
          <h3 class="panel-title">Fleet share</h3>
          <div id="distribution"></div>
        </div>
      </aside>

      <section class="panel results" aria-live="polite">
        <div class="results-head">
          <div><h2 id="resultCount" class="result-count">Loading manifest…</h2><div id="resultMeta" class="result-meta">正在读取本地 catalogue.json</div></div>
          <select id="sort" class="control" aria-label="排序方式">
            <option value="date-asc">出发日期 · 由近到远</option>
            <option value="date-desc">出发日期 · 由远到近</option>
            <option value="nights-desc">晚数 · 由长到短</option>
            <option value="ship">船名 · A–Z</option>
          </select>
        </div>
        <div id="manifest" class="manifest"></div>
        <button id="loadMore" class="load-more" type="button" hidden>显示更多</button>
      </section>
    </div>

    <section class="panel audit-strip">
      <div class="audit-copy"><strong>数据更新时间：</strong><span id="freshness"><%= generatedAt %></span><br><strong>Source：</strong> <a class="source-link" href="<%= sourceUrl %>" target="_blank" rel="noopener">Explora official cruise catalogue ↗</a></div>
      <button id="copyCommand" class="command" type="button">refresh catalogue + details</button>
    </section>

    <section class="panel port-dictionary">
      <div class="dictionary-head"><div><h2 class="panel-title">Gateway Port Dictionary</h2><div class="dictionary-note">官方港口名保持原样；中文展示与门户关系作为 WR editorial annotation 独立维护。</div></div><div id="portCount" class="dictionary-note"></div></div>
      <div id="portGrid" class="port-grid"></div>
    </section>
  </main>

  <script>
    const state = { catalogue: null, filtered: [], visible: 60 };
    const $ = (id) => document.getElementById(id);
    const formatDate = (iso) => new Intl.DateTimeFormat('en-GB', { day: '2-digit', month: 'short' }).format(new Date(iso + 'T00:00:00Z'));
    const escapeHtml = (value) => String(value).replace(/[&<>'"]/g, (char) => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', "'":'&#39;', '"':'&quot;' }[char]));

    function populateFilters(catalogue) {
      catalogue.vessels.forEach((vessel) => $('vessel').insertAdjacentHTML('beforeend', `<option value="${escapeHtml(vessel.id)}">${escapeHtml(vessel.name)}</option>`));
      const regions = new Map();
      catalogue.voyages.forEach((voyage) => voyage.regions.forEach((region) => regions.set(region.code, region.name)));
      [...regions.entries()].sort((a, b) => a[1].localeCompare(b[1])).forEach(([code, name]) => $('region').insertAdjacentHTML('beforeend', `<option value="${escapeHtml(code)}">${escapeHtml(name)} · ${escapeHtml(code)}</option>`));
      renderDistribution(catalogue.departures, catalogue.vessels);
      renderPortDictionary(catalogue.ports);
    }

    function portLabel(port, fallback) {
      return port?.annotation?.display_zh || port?.official_name || fallback;
    }

    function renderPortDictionary(ports) {
      const annotated = ports.filter((port) => port.annotation);
      $('portCount').textContent = `${annotated.length} 个首批人工注解 · 共 ${ports.length} 个官方港口`;
      $('portGrid').innerHTML = annotated.map((port) => `
        <article class="port-card">
          <div class="port-code">${escapeHtml(port.code)} · ${escapeHtml(port.country_code)}</div>
          <div class="port-display">${escapeHtml(port.annotation.display_zh)}</div>
          <div class="port-official">Official: ${escapeHtml(port.official_name)}, ${escapeHtml(port.country)}</div>
          <div class="port-note">${escapeHtml(port.annotation.note_zh)}</div>
          <div class="port-meta">${port.arrival_methods.map((method) => `<span class="region-tag">${escapeHtml(method)}</span>`).join('')}<span class="region-tag">${escapeHtml(port.annotation.annotation_type)}</span></div>
        </article>`).join('');
    }

    function renderDistribution(departures, vessels) {
      const counts = departures.reduce((map, item) => map.set(item.vessel_id, (map.get(item.vessel_id) || 0) + 1), new Map());
      const max = Math.max(...counts.values());
      $('distribution').innerHTML = vessels.map((vessel) => {
        const count = counts.get(vessel.id) || 0;
        return `<div class="dist-row"><div class="dist-meta"><span>${escapeHtml(vessel.name)}</span><strong>${count}</strong></div><div class="dist-track"><div class="dist-fill" style="width:${(count / max) * 100}%"></div></div></div>`;
      }).join('');
    }

    function applyFilters() {
      if (!state.catalogue) return;
      const query = $('search').value.trim().toLowerCase();
      const vessel = $('vessel').value;
      const region = $('region').value;
      const month = $('month').value;
      const multiOnly = $('multi').checked;
      const tenderOnly = $('tender').checked;
      const annotatedOnly = $('annotated').checked;
      state.filtered = state.catalogue.departures.filter((item) => {
        const itineraryPorts = (item.itinerary || []).map((day) => day.port_name).filter(Boolean).join(' ');
        const annotations = [item.start_port?.annotation?.display_zh, item.end_port?.annotation?.display_zh].filter(Boolean).join(' ');
        const haystack = [item.id, item.embarkation_port, item.disembarkation_port, item.voyage_ids.join(' '), itineraryPorts, annotations].join(' ').toLowerCase();
        return (!query || haystack.includes(query))
          && (!vessel || item.vessel_id === vessel)
          && (!region || item.region_codes.includes(region))
          && (!month || item.embarkation_date.startsWith(month))
          && (!multiOnly || item.voyage_ids.length > 1)
          && (!tenderOnly || item.metrics?.tender_calls > 0)
          && (!annotatedOnly || item.start_port?.annotation || item.end_port?.annotation);
      });
      const sort = $('sort').value;
      state.filtered.sort((a, b) => {
        if (sort === 'date-desc') return b.embarkation_date.localeCompare(a.embarkation_date);
        if (sort === 'nights-desc') return b.nights - a.nights || a.embarkation_date.localeCompare(b.embarkation_date);
        if (sort === 'ship') return a.vessel_id.localeCompare(b.vessel_id) || a.embarkation_date.localeCompare(b.embarkation_date);
        return a.embarkation_date.localeCompare(b.embarkation_date);
      });
      state.visible = 60;
      render();
    }

    function render() {
      const rows = state.filtered.slice(0, state.visible);
      $('resultCount').textContent = `${state.filtered.length} departures`;
      $('resultMeta').textContent = state.filtered.length ? `显示 ${Math.min(state.visible, state.filtered.length)} 条 · 点击任一行打开官方详情` : '没有符合当前筛选条件的航次';
      $('manifest').innerHTML = rows.length ? rows.map((item, index) => `
        <a class="voyage-row" href="${escapeHtml(item.source_url)}" target="_blank" rel="noopener" style="animation-delay:${Math.min(index, 12) * 24}ms">
          <div><div class="date-day">${formatDate(item.embarkation_date)}</div><div class="date-year">${item.embarkation_date.slice(0,4)} → ${formatDate(item.disembarkation_date)}</div></div>
          <div><div class="route">${escapeHtml(portLabel(item.start_port, item.embarkation_port))} → ${escapeHtml(portLabel(item.end_port, item.disembarkation_port))}</div><div class="official-route">Official: ${escapeHtml(item.embarkation_port)} → ${escapeHtml(item.disembarkation_port)}</div><div class="journey-id">${escapeHtml(item.id)}</div><div class="metric-list"><span class="metric-tag accent">${item.metrics?.full_day_calls || 0} full-day</span><span class="metric-tag">${item.metrics?.late_departures || 0} late</span>${item.metrics?.sea_days ? `<span class="metric-tag">${item.metrics.sea_days} sea</span>` : ''}${item.metrics?.tender_calls ? `<span class="metric-tag">${item.metrics.tender_calls} tender</span>` : ''}</div></div>
          <div><div class="ship-name">${escapeHtml(item.vessel_id.replace('explora-', 'EXPLORA ').toUpperCase())}</div><div class="region-list">${item.region_codes.map((code) => `<span class="region-tag">${escapeHtml(code)}</span>`).join('')}</div>${item.voyage_ids.length > 1 ? `<div class="multi">${item.voyage_ids.length} voyage links</div>` : ''}</div>
          <div><div class="night-value">${item.nights}</div><div class="night-label">NIGHTS</div></div>
          <div><div>${item.metrics?.full_day_calls || 0}/${item.metrics?.timed_calls || 0}</div><div class="end-label">FULL-DAY CALLS</div></div>
          <div class="arrow">→</div>
        </a>`).join('') : '<div class="empty">换一个港口、月份或船名再试试。</div>';
      $('loadMore').hidden = state.visible >= state.filtered.length;
      $('loadMore').textContent = `显示更多 · 余 ${state.filtered.length - state.visible} 条`;
    }

    ['search', 'vessel', 'region', 'month', 'multi', 'tender', 'annotated', 'sort'].forEach((id) => $(id).addEventListener(id === 'search' ? 'input' : 'change', applyFilters));
    $('reset').addEventListener('click', () => { $('search').value=''; $('vessel').value=''; $('region').value=''; $('month').value=''; $('multi').checked=false; $('tender').checked=false; $('annotated').checked=false; $('sort').value='date-asc'; applyFilters(); });
    $('loadMore').addEventListener('click', () => { state.visible += 60; render(); });
    $('copyCommand').addEventListener('click', async () => { await navigator.clipboard.writeText('cd /Users/iori2/wr-journeys && npm run ingest:explora && npm run enrich:explora'); $('copyCommand').textContent='Copied ✓'; setTimeout(() => $('copyCommand').textContent='refresh catalogue + details', 1400); });

    fetch('/internal/explora-review/data.json', { cache: 'no-store' })
      .then((response) => { if (!response.ok) throw new Error(`HTTP ${response.status}`); return response.json(); })
      .then((catalogue) => { state.catalogue = catalogue; populateFilters(catalogue); applyFilters(); $('freshness').textContent = new Date(catalogue.generated_at).toLocaleString('zh-CN', { hour12: false }); })
      .catch((error) => { $('resultCount').textContent = 'Catalogue unavailable'; $('resultMeta').textContent = error.message; $('manifest').innerHTML = '<div class="empty">请先运行 npm run ingest:explora。</div>'; });
  </script>
</body>
</html>
