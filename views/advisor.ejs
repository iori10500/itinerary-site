<!DOCTYPE html>
<html lang="<%= lang === 'en' ? 'en' : 'zh-CN' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <meta name="description" content="<%= lang === 'en' ? 'Plan a private slow-luxury journey with a real advisor. Every enquiry is personally reviewed by our owner.' : '与真人旅行顾问规划私人慢奢旅程，每一条询价都由本店主理人亲自阅读。' %>">
  <link rel="canonical" href="https://itinerary.wildroadgroup.com<%= lang === 'en' ? '/en' : '' %>/advisor">
  <link rel="alternate" hreflang="zh-CN" href="https://itinerary.wildroadgroup.com/advisor">
  <link rel="alternate" hreflang="en" href="https://itinerary.wildroadgroup.com/en/advisor">
  <link rel="alternate" hreflang="x-default" href="https://itinerary.wildroadgroup.com/advisor">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="stylesheet" href="/fonts/fonts.css">
  <link rel="stylesheet" href="/main.css?v=20260801">
  <link rel="stylesheet" href="/enquiry.css">
  <script type="application/ld+json"><%- JSON.stringify({
    '@context': 'https://schema.org', '@type': 'ContactPage',
    name: lang === 'en' ? 'Talk to your travel advisor' : '与旅行顾问聊聊',
    description: lang === 'en' ? 'Begin a human-led journey. AI helps WR Journeys connect faster; listening, planning and end-to-end care remain with a real advisor.' : '从真人聆听开始规划旅程。AI 帮助 WR Journeys 更快联络，规划与从始至终的照顾由真人顾问负责。',
    url: `https://itinerary.wildroadgroup.com${lang === 'en' ? '/en' : ''}/advisor`,
    isPartOf: { '@type': 'WebSite', name: 'WR Journeys', url: 'https://itinerary.wildroadgroup.com' }
  }) %></script>
  <%- include('partials/ga') %>
  <script src="/cdn-fallback.js" defer></script>
</head>
<body class="advisor-page">
  <%- include('partials/header') %>
  <button onclick="toggleLang()" class="lang-toggle"><%= lang === 'en' ? '中' : 'EN' %></button>

  <main>
    <section class="advisor-hero">
      <div class="advisor-hero__grain"></div>
      <div class="advisor-hero__copy">
        <p class="advisor-kicker">WR JOURNEYS · PRIVATE PLANNING</p>
        <h1><%= lang === 'en' ? 'A journey begins with being understood.' : '一段旅程，始于真正被理解。' %></h1>
        <p><%= lang === 'en' ? 'No call centre. No automated itinerary hand-off. AI helps us connect and coordinate faster; our owner personally listens, shapes the first direction with you, and stays involved through your return.' : '没有呼叫中心，也不会把行程交给自动系统。AI 帮助我们更快联络与协调；本店主理人亲自聆听，和您确定最初的方向，并一路跟进到旅行归来。' %></p>
      </div>
      <aside class="advisor-hero__promise">
        <div><span>01</span><p><strong><%= lang === 'en' ? 'A real human' : '真人接待' %></strong><%= lang === 'en' ? 'One advisor follows the thread from first idea to return.' : '从第一条想法到旅行归来，由同一位顾问持续跟进。' %></p></div>
        <div><span>02</span><p><strong><%= lang === 'en' ? 'A considered reply' : '明确回复时效' %></strong><%= lang === 'en' ? 'Email reply within 24 hours.' : '工作时间内，中文询价 20 分钟内回复。' %></p></div>
        <div><span>03</span><p><strong><%= lang === 'en' ? 'Planning is complimentary' : '规划不收费' %></strong><%= lang === 'en' ? 'No planning fee until you decide to book.' : '确认落单前，不收取咨询或规划费用。' %></p></div>
      </aside>
    </section>

    <section class="advisor-intro<%= lang !== 'en' && wechatQrPath ? ' advisor-intro--with-qr' : ' advisor-intro--text-only' %>">
      <% if (lang !== 'en' && wechatQrPath) { %>
      <figure class="advisor-qr">
        <img src="<%= wechatQrPath %>" alt="WR Journeys 顾问微信二维码">
        <figcaption>微信扫码 · 与顾问直接沟通</figcaption>
      </figure>
      <% } %>
      <div>
        <p class="advisor-kicker"><%= lang === 'en' ? 'THE OWNER BEHIND THE JOURNEY' : '旅程背后的主理人' %></p>
        <h2><%= lang === 'en' ? 'Hospitality experience, translated into your journey.' : '把酒店行业经验，翻译成属于您的旅程。' %></h2>
        <p><%= lang === 'en' ? 'More than a decade inside China’s hospitality industry has built direct relationships with boutique hotel founders, global luxury brands and local operators. That access matters—but judgement matters more: knowing when to stay longer, what to leave out, and which details will change the way a place feels.' : '十余年的酒店行业经验，连接精品酒店主理人、全球奢华品牌与在地运营者。资源重要，但判断更重要：在哪里多住一晚、哪些景点应该舍弃、什么细节会真正改变一段旅程。' %></p>
      </div>
    </section>

    <section class="advisor-form-section" id="plan">
      <div class="advisor-form-heading">
        <p class="advisor-kicker"><%= lang === 'en' ? 'START WITH A FEW DETAILS' : '从几个细节开始' %></p>
        <h2><%= route ? (lang === 'en' ? 'Shape this journey around you.' : '让这条路线真正属于您。') : (lang === 'en' ? 'Tell us where your mind is wandering.' : '告诉我们，您正向往哪里。') %></h2>
        <p><%= lang === 'en' ? 'You do not need a complete brief. A destination, a feeling, or a rough month is enough.' : '不需要准备完整需求。一个目的地、一种感受，或大致月份，就足够开始。' %></p>
      </div>
      <div class="advisor-form-shell">
        <%- include('partials/enquiry-form', { variant: route ? 'long' : 'short', source: source, route: route }) %>
      </div>
      <div class="advisor-direct">
        <span><%= lang === 'en' ? 'Prefer email?' : '也可以直接发邮件' %></span>
        <a href="mailto:<%= advisorEmail %>"><%= advisorEmail %></a>
        <% if (lang !== 'en') { %><small>提交后，顾问也可通过您填写的微信号联系。</small><% } %>
      </div>
    </section>
  </main>

  <%- include('partials/footer') %>
  <script>function toggleLang(){const u=new URL(window.location);const p=u.pathname;const isEn=p==='/en'||p.startsWith('/en/');u.pathname=isEn?(p==='/en'?'/':p.substring(3)):(p==='/'?'/en':'/en'+p);u.searchParams.delete('lang');window.location=u.toString()}</script>
</body>
</html>
