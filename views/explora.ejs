<!DOCTYPE html>
<html lang="<%= lang === 'en' ? 'en' : 'zh-CN' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= lang === 'en' ? 'Explora Journeys | Ocean journeys, thoughtfully selected' : 'Explora Journeys｜慢奢海上旅程' %> | WR Journeys</title>
  <meta name="description" content="<%= lang === 'en' ? 'Explore current Explora Journeys sailings by ship, region and date, with port context and private planning by WR Travel.' : '按船只、海域和日期浏览 Explora Journeys 当前公布航程，并由 WR Travel 提供港口解读与私人行程规划。' %>">
  <link rel="canonical" href="https://itinerary.wildroadgroup.com<%= lang === 'en' ? '/en' : '' %>/brands/explora">
  <link rel="alternate" hreflang="zh-CN" href="https://itinerary.wildroadgroup.com/brands/explora">
  <link rel="alternate" hreflang="en" href="https://itinerary.wildroadgroup.com/en/brands/explora">
  <link rel="alternate" hreflang="x-default" href="https://itinerary.wildroadgroup.com/brands/explora">
  <meta property="og:title" content="Explora Journeys | WR Journeys">
  <meta property="og:description" content="<%= lang === 'en' ? 'Days belong to the destination. Nights belong to the ocean.' : '白天留给目的地，夜晚交给海洋。' %>">
  <meta property="og:url" content="https://itinerary.wildroadgroup.com<%= lang === 'en' ? '/en' : '' %>/brands/explora">
  <meta property="og:type" content="website">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <% if (lang === 'en') { %><link rel="preload" href="/fonts/inter-all.woff2" as="font" type="font/woff2" crossorigin><% } %>
  <link rel="preload" href="/fonts/playfair-display.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/playfair-all.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/fonts/fonts.css">
  <% if (lang !== 'en') { %><link href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@300;400;500;600&display=swap" rel="stylesheet"><% } %>
  <link rel="stylesheet" href="/main.css">
  <style>
    :root { --ink:#13242a; --deep:#0d3439; --sea:#376d70; --foam:#eef3ef; --sand:#d8c5a5; --paper:#f8f6f1; }
    * { box-sizing:border-box; }
    body { margin:0; color:var(--ink); background:var(--paper); font-family:<%- lang === 'en' ? "'Inter', -apple-system, BlinkMacSystemFont, sans-serif" : "'Noto Sans SC', 'Inter', -apple-system, BlinkMacSystemFont, sans-serif" %>; }
    .explora-hero { min-height:680px; position:relative; overflow:hidden; color:#fff; display:grid; place-items:center; padding:88px 24px 64px; background:linear-gradient(145deg,#092b31 0%,#1a5053 53%,#9daea5 100%); }
    .explora-hero::before { content:""; position:absolute; width:760px; height:760px; border:1px solid rgba(255,255,255,.17); border-radius:50%; right:-170px; top:-280px; box-shadow:0 0 0 90px rgba(255,255,255,.025),0 0 0 180px rgba(255,255,255,.02); }
    .explora-hero::after { content:""; position:absolute; inset:auto 0 0; height:40%; background:linear-gradient(180deg,transparent,rgba(5,28,32,.52)); clip-path:polygon(0 48%,18% 56%,35% 42%,57% 63%,75% 46%,100% 58%,100% 100%,0 100%); }
    .hero-inner { position:relative; z-index:1; max-width:1040px; width:100%; text-align:center; }
    .hero-back { color:rgba(255,255,255,.67); text-decoration:none; font-size:12px; letter-spacing:.08em; }
    .eyebrow { margin:62px 0 20px; font-size:11px; font-weight:500; letter-spacing:.3em; text-transform:uppercase; color:#e3d3b8; }
    .explora-hero h1 { font-family:'Playfair Display',serif; font-size:clamp(48px,8vw,104px); font-weight:400; letter-spacing:-.035em; margin:0; line-height:.96; }
    .hero-line { font-family:'Playfair Display',serif; font-style:italic; font-size:clamp(22px,3.2vw,40px); font-weight:400; margin:24px auto 14px; max-width:780px; }
    .hero-copy { color:rgba(255,255,255,.76); max-width:650px; margin:0 auto; line-height:1.8; font-size:14px; }
    .hero-actions { display:flex; flex-wrap:wrap; gap:12px; justify-content:center; margin-top:34px; }
    .btn { display:inline-flex; min-height:47px; align-items:center; justify-content:center; padding:0 24px; border-radius:2px; text-decoration:none; font-size:13px; letter-spacing:.05em; border:1px solid transparent; cursor:pointer; }
    .btn-light { background:#f5eee2; color:#173b3e; }
    .btn-ghost { border-color:rgba(255,255,255,.45); color:#fff; background:transparent; }
    .proof { position:relative; z-index:2; margin-top:-1px; background:var(--deep); color:#fff; display:grid; grid-template-columns:repeat(3,1fr); }
    .proof-item { text-align:center; padding:30px 18px; border-right:1px solid rgba(255,255,255,.11); }
    .proof-item:last-child { border:0; }
    .proof-number { font-family:'Playfair Display',serif; font-size:34px; color:#e1d1b3; }
    .proof-label { display:block; margin-top:6px; font-size:11px; color:rgba(255,255,255,.63); letter-spacing:.06em; }
    .section { max-width:1240px; margin:0 auto; padding:96px 28px; }
    .intro { display:grid; grid-template-columns:minmax(0,1.1fr) minmax(260px,.65fr); gap:90px; align-items:end; }
    .section-kicker { font-size:11px; color:var(--sea); letter-spacing:.22em; text-transform:uppercase; margin:0 0 16px; }
    .section h2 { font-family:'Playfair Display',serif; font-size:clamp(36px,5vw,62px); line-height:1.08; font-weight:400; margin:0; letter-spacing:-.025em; }
    .intro-copy { font-size:15px; line-height:2; color:#506166; margin:0; }
    .catalogue { background:#fff; border-top:1px solid #e7e6e0; border-bottom:1px solid #e7e6e0; }
    .catalogue .section { padding-top:78px; }
    .catalogue-heading { display:flex; justify-content:space-between; gap:32px; align-items:end; margin-bottom:38px; }
    .catalogue-note { max-width:470px; color:#6b777a; font-size:12px; line-height:1.7; }
    .filters { display:grid; grid-template-columns:1.4fr repeat(3,1fr); gap:10px; padding:16px; background:#f1f3ef; border:1px solid #e1e6df; }
    .field { position:relative; }
    .field label { display:block; font-size:10px; letter-spacing:.1em; text-transform:uppercase; color:#74807f; margin:0 0 7px; }
    .field input,.field select { width:100%; min-height:43px; padding:0 12px; border:1px solid #d5dcd7; border-radius:0; background:#fff; color:var(--ink); font:13px inherit; }
    .results-bar { display:flex; justify-content:space-between; align-items:center; padding:24px 2px 16px; color:#6b777a; font-size:12px; }
    .reset { border:0; background:none; color:var(--sea); cursor:pointer; padding:6px 0; font:inherit; }
    .journey-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:18px; }
    .journey-card { display:flex; flex-direction:column; min-height:370px; border:1px solid #e0e4df; background:#fbfbf8; padding:24px; transition:transform .2s,box-shadow .2s; }
    .journey-card:hover { transform:translateY(-3px); box-shadow:0 16px 40px rgba(24,52,55,.09); }
    .card-top { display:flex; justify-content:space-between; gap:18px; font-size:11px; letter-spacing:.08em; color:#657879; text-transform:uppercase; }
    .card-route { font-family:'Playfair Display',serif; font-size:25px; line-height:1.22; margin:34px 0 8px; color:#17383b; }
    .port-official { font-size:10px; color:#85908f; line-height:1.45; min-height:15px; }
    .route-arrow { display:block; width:40px; border-top:1px solid #b4a17f; margin:16px 0; position:relative; }
    .route-arrow::after { content:""; position:absolute; right:0; top:-3px; width:5px; height:5px; border-top:1px solid #b4a17f; border-right:1px solid #b4a17f; transform:rotate(45deg); }
    .card-badges { display:flex; flex-wrap:wrap; gap:6px; margin:22px 0; }
    .badge { border:1px solid #dce3de; padding:5px 8px; color:#5f706f; font-size:10px; background:#fff; }
    .card-actions { margin-top:auto; display:grid; grid-template-columns:1fr 1fr; gap:8px; }
    .card-actions a { min-height:40px; display:flex; align-items:center; justify-content:center; text-align:center; text-decoration:none; font-size:11px; padding:8px; border:1px solid var(--deep); }
    .card-primary { color:#fff; background:var(--deep); }
    .card-secondary { color:var(--deep); background:transparent; }
    .empty { display:none; padding:70px 20px; text-align:center; color:#788281; }
    .load-more { display:none; margin:30px auto 0; background:transparent; color:var(--deep); border:1px solid #95aaa5; }
    .port-note { margin-top:56px; padding:22px 26px; border-left:2px solid var(--sand); background:#f6f3ec; color:#667170; font-size:12px; line-height:1.8; }
    .closing { padding:100px 24px; text-align:center; color:#fff; background:var(--deep); }
    .closing h2 { font-family:'Playfair Display',serif; font-size:clamp(36px,5vw,58px); font-weight:400; margin:0 0 18px; }
    .closing p { color:rgba(255,255,255,.65); font-size:14px; margin:0 auto 30px; max-width:600px; line-height:1.8; }
    .loading { grid-column:1/-1; padding:80px 20px; text-align:center; color:#6d7d7b; }
    @media(max-width:900px){.intro{grid-template-columns:1fr;gap:28px}.journey-grid{grid-template-columns:repeat(2,1fr)}.filters{grid-template-columns:1fr 1fr}.catalogue-heading{display:block}.catalogue-note{margin-top:18px}.explora-hero{min-height:620px}}
    @media(max-width:620px){.proof{grid-template-columns:1fr}.proof-item{border-right:0;border-bottom:1px solid rgba(255,255,255,.11);padding:20px}.journey-grid{grid-template-columns:1fr}.filters{grid-template-columns:1fr}.section{padding:68px 18px}.explora-hero{padding-left:18px;padding-right:18px}.eyebrow{margin-top:36px}.card-actions{grid-template-columns:1fr}.catalogue-heading{margin-bottom:26px}}
  </style>
  <%- include('partials/jsonld') %>
  <%- include('partials/ga') %>
</head>
<body>
  <%- include('partials/header') %>
  <button id="langToggle" onclick="toggleLang()" class="lang-toggle"><%= lang === 'en' ? '中' : 'EN' %></button>

  <main>
    <section class="explora-hero">
      <div class="hero-inner">
        <a class="hero-back" href="<%= lang === 'en' ? '/en' : '' %>/brands"><%= lang === 'en' ? '← BRAND HOUSE' : '← 品牌矩阵' %></a>
        <p class="eyebrow">Ocean journeys · Curated by WR Travel</p>
        <h1>Explora<br>Journeys</h1>
        <p class="hero-line"><%= lang === 'en' ? 'Days belong to the destination. Nights belong to the ocean.' : '白天留给目的地，夜晚交给海洋。' %></p>
        <p class="hero-copy"><%= lang === 'en' ? 'A considered way to travel by sea: longer days ashore, unrushed transitions and a journey shaped around the places themselves.' : '以更从容的节奏穿行海陆：把完整白天交给岸上探索，把跨城移动留给夜色与海面。' %></p>
        <div class="hero-actions">
          <a class="btn btn-light" href="#journeys"><%= lang === 'en' ? 'Explore sailings' : '浏览当前航程' %></a>
          <a class="btn btn-ghost" href="<%= advisorUrl(lang, { source: 'explora-hero' }) %>" data-enquiry-cta="explora-hero"><%= lang === 'en' ? 'Plan with an advisor' : '与顾问一起规划' %></a>
        </div>
      </div>
    </section>

    <div class="proof" aria-label="<%= lang === 'en' ? 'Catalogue highlights' : '航程特点' %>">
      <div class="proof-item"><span class="proof-number"><%= Math.round(detailsStats.late_departure_share * 1000) / 10 %>%</span><span class="proof-label"><%= lang === 'en' ? 'OF TIMED CALLS DEPART AT 18:00 OR LATER' : '有明确时间的靠港于 18:00 后离港' %></span></div>
      <div class="proof-item"><span class="proof-number"><%= Math.round(detailsStats.full_day_share * 1000) / 10 %>%</span><span class="proof-label"><%= lang === 'en' ? 'ARRIVE BY 10:00 AND DEPART AT 18:00 OR LATER' : '于 10:00 前抵达并在 18:00 后离港' %></span></div>
      <div class="proof-item"><span class="proof-number"><%= stats.departures %></span><span class="proof-label"><%= lang === 'en' ? 'CURRENTLY PUBLISHED DEPARTURES REVIEWED' : '已整理的当前公布出发日期' %></span></div>
    </div>

    <section class="section intro">
      <div>
        <p class="section-kicker"><%= lang === 'en' ? 'The value of travelling at sea' : '海上移动的价值' %></p>
        <h2><%= lang === 'en' ? 'More places, without making the journey feel hurried.' : '去更多地方，旅途却不必更仓促。' %></h2>
      </div>
      <p class="intro-copy"><%= lang === 'en' ? 'Many sailings move between ports overnight, reducing repeated airport, station and hotel transfers. It does not make every day a full day ashore—but the published schedules show that late departures are common. We use the exact port and timing data to find the rhythm that suits you.' : '许多航段在夜间完成港口之间的移动，减少反复往返机场、车站与酒店的时间。并非每一天都能完整留在岸上，但公开时刻表显示，晚间离港相当普遍。我们会根据真实港口与靠离港时间，为你筛选合适的旅行节奏。' %></p>
    </section>

    <section class="catalogue" id="journeys">
      <div class="section">
        <div class="catalogue-heading">
          <div><p class="section-kicker"><%= lang === 'en' ? 'Live catalogue' : '当前航程目录' %></p><h2><%= lang === 'en' ? 'Find your way across the ocean.' : '找到适合你的海上路径。' %></h2></div>
          <p class="catalogue-note"><%= lang === 'en' ? 'Sailing dates and port names follow Explora Journeys’ currently published catalogue. Availability and fares are confirmed at enquiry.' : '出发日期及港口名称依据 Explora Journeys 当前公开目录整理；实际余位与价格以咨询时确认为准。' %></p>
        </div>

        <div class="filters" role="search">
          <div class="field"><label for="journey-search"><%= lang === 'en' ? 'Port or journey' : '港口或航程' %></label><input id="journey-search" type="search" placeholder="<%= lang === 'en' ? 'e.g. Athens, Rome…' : '例如 Athens、罗马…' %>" autocomplete="off"></div>
          <div class="field"><label for="vessel-filter"><%= lang === 'en' ? 'Ship' : '船只' %></label><select id="vessel-filter"><option value=""><%= lang === 'en' ? 'All ships' : '全部船只' %></option></select></div>
          <div class="field"><label for="region-filter"><%= lang === 'en' ? 'Region' : '海域' %></label><select id="region-filter"><option value=""><%= lang === 'en' ? 'All regions' : '全部海域' %></option></select></div>
          <div class="field"><label for="month-filter"><%= lang === 'en' ? 'Departure' : '出发月份' %></label><select id="month-filter"><option value=""><%= lang === 'en' ? 'Any month' : '全部月份' %></option></select></div>
        </div>
        <div class="results-bar"><span id="result-count"><%= lang === 'en' ? 'Loading journeys…' : '正在载入航程…' %></span><button class="reset" id="reset-filters" type="button"><%= lang === 'en' ? 'Clear filters' : '清除筛选' %></button></div>
        <div class="journey-grid" id="journey-grid"><div class="loading"><%= lang === 'en' ? 'Reading the latest catalogue…' : '正在读取最新目录…' %></div></div>
        <div class="empty" id="empty-state"><%= lang === 'en' ? 'No sailings match these filters. Try another month or region.' : '没有符合当前条件的航程，试试其他月份或海域。' %></div>
        <button class="btn load-more" id="load-more" type="button"><%= lang === 'en' ? 'Show more sailings' : '显示更多航程' %></button>
        <div class="port-note"><strong><%= lang === 'en' ? 'A note on port names.' : '关于港口名称。' %></strong> <%= lang === 'en' ? 'We retain the operator’s official port name. Where a port is marketed through a nearby gateway city—such as Civitavecchia for Rome—the actual port remains explicit.' : '页面保留船方官方港口英文名。遇到以邻近城市宣传的门户港（例如罗马对应的奇维塔韦基亚），会明确标注实际靠港地与门户城市关系。' %></div>
      </div>
    </section>

    <section class="closing">
      <h2><%= lang === 'en' ? 'A sailing is only the beginning.' : '航程，只是旅途的起点。' %></h2>
      <p><%= lang === 'en' ? 'We can connect the voyage with flights, hotels and private stays before or after sailing—without losing the slower rhythm that made you choose the ocean.' : '我们可以继续衔接航前航后的机票、酒店与陆地停留，让整段旅程保持你选择海上旅行时想要的从容。' %></p>
      <a class="btn btn-light" href="<%= advisorUrl(lang, { source: 'explora-closing' }) %>" data-enquiry-cta="explora-closing"><%= lang === 'en' ? 'Talk to a travel advisor' : '联系旅行顾问' %></a>
    </section>
  </main>

  <%- include('partials/footer') %>
  <script>
  (function(){
    var isEn=<%- JSON.stringify(lang === 'en') %>;
    var prefix=isEn?'/en':'';
    var all=[];var filtered=[];var shown=18;var pageSize=18;
    var grid=document.getElementById('journey-grid');
    var empty=document.getElementById('empty-state');
    var more=document.getElementById('load-more');
    var count=document.getElementById('result-count');
    var search=document.getElementById('journey-search');
    var vessel=document.getElementById('vessel-filter');
    var region=document.getElementById('region-filter');
    var month=document.getElementById('month-filter');
    var regionNames={MED:['地中海','Mediterranean'],CAR:['加勒比海','Caribbean'],ALA:['阿拉斯加','Alaska'],CAN:['加拿大与新英格兰','Canada & New England'],FAE:['北欧与峡湾','Northern Europe & Fjords'],ICE:['冰岛与格陵兰','Iceland & Greenland'],API:['亚洲','Asia'],PAC:['太平洋','Pacific'],SOA:['南美洲','South America'],TRA:['跨洋航行','Ocean Crossing'],WOR:['环球航程','World Journey']};
    function t(zh,en){return isEn?en:zh}
    function track(name,params){if(typeof window.gtag==='function')window.gtag('event',name,params||{})}
    function option(select,value,label){var o=document.createElement('option');o.value=value;o.textContent=label;select.appendChild(o)}
    function portText(p){return !p?'—':(!isEn&&p.display_zh?p.display_zh:p.official_name)}
    function officialText(p){return !p?'':(!isEn&&p.display_zh?p.official_name:'')}
    function dateText(value){return new Intl.DateTimeFormat(isEn?'en-GB':'zh-CN',{year:'numeric',month:'short',day:'numeric',timeZone:'UTC'}).format(new Date(value+'T00:00:00Z'))}
    function badge(text){var el=document.createElement('span');el.className='badge';el.textContent=text;return el}
    function makeCard(j){
      var card=document.createElement('article');card.className='journey-card';
      var top=document.createElement('div');top.className='card-top';top.innerHTML='<span></span><span></span>';top.children[0].textContent=(j.vessel_name||j.vessel_id);top.children[1].textContent=j.nights+' '+t('晚','nights');card.appendChild(top);
      var route=document.createElement('div');route.className='card-route';
      var start=document.createElement('div');start.textContent=portText(j.start_port);route.appendChild(start);
      var startOfficial=document.createElement('div');startOfficial.className='port-official';startOfficial.textContent=officialText(j.start_port);route.appendChild(startOfficial);
      var arrow=document.createElement('span');arrow.className='route-arrow';route.appendChild(arrow);
      var end=document.createElement('div');end.textContent=portText(j.end_port);route.appendChild(end);
      var endOfficial=document.createElement('div');endOfficial.className='port-official';endOfficial.textContent=officialText(j.end_port);route.appendChild(endOfficial);card.appendChild(route);
      var dates=document.createElement('div');dates.style.cssText='font-size:12px;color:#697878';dates.textContent=dateText(j.embarkation_date)+' — '+dateText(j.disembarkation_date);card.appendChild(dates);
      var badges=document.createElement('div');badges.className='card-badges';
      var m=j.metrics||{};if(m.full_day_calls)badges.appendChild(badge(m.full_day_calls+' '+t('个完整靠港日','full-day calls')));if(m.late_departures)badges.appendChild(badge(m.late_departures+' '+t('次晚间离港','late departures')));if(m.overnight_events)badges.appendChild(badge(m.overnight_events+' '+t('次过夜停靠','overnight')));if(m.tender_calls)badges.appendChild(badge(t('含接驳艇靠岸','tender calls')));card.appendChild(badges);
      var actions=document.createElement('div');actions.className='card-actions';
      var ask=document.createElement('a');ask.className='card-primary';ask.href=prefix+'/advisor?source='+encodeURIComponent('explora-'+j.id);ask.dataset.enquiryCta='explora-journey-card';ask.dataset.journeyId=j.id;ask.textContent=t('咨询这段航程','Enquire about this sailing');actions.appendChild(ask);
      var official=document.createElement('a');official.className='card-secondary';official.href=j.source_url;official.target='_blank';official.rel='noopener';official.textContent=t('查看船方行程 ↗','Official itinerary ↗');official.addEventListener('click',function(){track('explora_journey_open',{journey_id:j.id,vessel_id:j.vessel_id})});actions.appendChild(official);card.appendChild(actions);return card;
    }
    function render(){grid.textContent='';filtered.slice(0,shown).forEach(function(j){grid.appendChild(makeCard(j))});empty.style.display=filtered.length?'none':'block';more.style.display=shown<filtered.length?'flex':'none';count.textContent=isEn?filtered.length+' sailings found':'找到 '+filtered.length+' 个出发日期'}
    function applyFilters(){
      var q=search.value.trim().toLowerCase();var v=vessel.value;var r=region.value;var m=month.value;
      filtered=all.filter(function(j){var hay=[j.id,j.start_port&&j.start_port.official_name,j.start_port&&j.start_port.display_zh,j.end_port&&j.end_port.official_name,j.end_port&&j.end_port.display_zh].filter(Boolean).join(' ').toLowerCase();return(!q||hay.includes(q))&&(!v||j.vessel_id===v)&&(!r||(j.region_codes||[]).includes(r))&&(!m||j.embarkation_date.slice(0,7)===m)});shown=pageSize;render();
    }
    function filterEvent(el,name){el.addEventListener(name==='search'?'input':'change',function(){applyFilters();track('explora_filter_use',{filter_name:name,has_value:Boolean(el.value)})})}
    fetch('/api/explora/journeys').then(function(r){if(!r.ok)throw new Error('catalogue');return r.json()}).then(function(data){
      var vesselNames={};(data.vessels||[]).forEach(function(v){vesselNames[v.id]=v.name;option(vessel,v.id,v.name)});
      var regionSet=new Set();var monthSet=new Set();all=(data.departures||[]).map(function(j){j.vessel_name=vesselNames[j.vessel_id]||j.vessel_id;(j.region_codes||[]).forEach(function(x){regionSet.add(x)});monthSet.add(j.embarkation_date.slice(0,7));return j});
      Array.from(regionSet).sort().forEach(function(code){var n=regionNames[code];option(region,code,n?(isEn?n[1]:n[0]):code)});
      Array.from(monthSet).sort().forEach(function(value){var label=new Intl.DateTimeFormat(isEn?'en-GB':'zh-CN',{year:'numeric',month:'long',timeZone:'UTC'}).format(new Date(value+'-01T00:00:00Z'));option(month,value,label)});
      filtered=all.slice();render();
    }).catch(function(){grid.innerHTML='<div class="loading">'+t('目录暂时无法载入，请稍后重试。','The catalogue is temporarily unavailable. Please try again later.')+'</div>';count.textContent='' });
    filterEvent(search,'search');filterEvent(vessel,'vessel');filterEvent(region,'region');filterEvent(month,'month');
    document.getElementById('reset-filters').addEventListener('click',function(){search.value='';vessel.value='';region.value='';month.value='';applyFilters();track('explora_filter_use',{filter_name:'reset',has_value:false})});
    more.addEventListener('click',function(){shown+=pageSize;render();track('explora_catalogue_more',{visible_count:Math.min(shown,filtered.length)})});
  })();
  function toggleLang(){var u=new URL(window.location);var p=u.pathname;var isEn=p==='/en'||p.startsWith('/en/');u.pathname=isEn?(p==='/en'?'/':p.substring(3)):(p==='/'?'/en':'/en'+p);localStorage.setItem('wr_lang',isEn?'zh':'en');window.location=u.toString()}
  </script>
</body>
</html>
